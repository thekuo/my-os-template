<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Overwrites the Capacitor template's styles.xml; the style names are the ones Capacitor expects. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/myos_icon_bg</item>
        <item name="colorPrimaryDark">@color/myos_bg</item>
        <item name="colorAccent">@color/myos_teal</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/myos_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch theme: system splash (Android 12+) or the compat splash, then AppTheme.NoActionBar -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/myos_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/myos_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
